ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=AlgoLingo Backend
PROJECT_VERSION=0.1.0
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=algolingo
# Optional override. If set, this value is used directly.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/algolingo

SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

JWT_SECRET_KEY=change-this-in-development-and-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b
OLLAMA_TIMEOUT_SECONDS=10
NOVA_MAX_REQUESTS_PER_HOUR=30
NOVA_MAX_RESPONSE_TOKENS=512
NOVA_MAX_HISTORY_MESSAGES=10

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=*
